{
    "name": "unifiscratch-microshield",
    "version": "1.0.0",
    "description": "Firmware de Unifiscratch para micro:shield (Make&Learn): ordenes por Bluetooth (UART) y USB",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*"
    },
    "files": [
        "main.ts",
        "kit.ts",
        "README.md"
    ],
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    },
    "preferredEditor": "tsprj"
}
