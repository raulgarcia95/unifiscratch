{
    "name": "unifyscratch-cutebot",
    "version": "1.0.0",
    "description": "Firmware de Unifyscratch para Cutebot: ordenes por Bluetooth (UART) y USB",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "microphone": "*"
    },
    "files": [
        "main.ts",
        "README.md"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
