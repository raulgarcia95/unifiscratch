{
    "name": "unifiscratch-wappsto-bit",
    "version": "1.0.0",
    "description": "Firmware de Unifiscratch para micro:bit con Wappsto:bit: órdenes por Bluetooth (UART) y USB, nube Wappsto por I2C",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*"
    },
    "files": [
        "main.ts",
        "README.md"
    ],
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null,
                    "partial_flashing": 0,
                    "dfu_service": 0,
                    "eddystone_url": 0,
                    "eddystone_uid": 0,
                    "event_service": 0,
                    "device_info_service": 0,
                    "pairing_mode": 0
                }
            }
        }
    },
    "preferredEditor": "tsprj"
}
